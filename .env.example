# Copilot only: GitHub OAuth token (obtained via Device Flow, starts with ghu_)
GITHUB_TOKEN=ghu_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: API key for authenticating client requests
API_KEY=your-api-key-here

# Optional: DeepSeek API key for deepseek-v4-pro models
# DeepSeek uses an Anthropic-compatible Messages API.
# Models: deepseek-v4-pro, deepseek-v4-pro[1m]
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: DeepSeek API host (defaults to https://api.deepseek.com)
# DEEPSEEK_HOST=https://api.deepseek.com

# Account type: individual, business, or enterprise
ACCOUNT_TYPE=individual

# Server port
PORT=6628

# Enable verbose logging
VERBOSE=false

# VS Code version to spoof in headers
VSCODE_VERSION=1.109.2

# Rate limit between requests (seconds, optional)
# RATE_LIMIT_SECONDS=5

# Native Microsoft Loki provider (direct Office upstream; no local Loki daemon)
LOKI_ENABLED=false
# prod, msit, or sdf
LOKI_ENVIRONMENT=prod
# Set false for Loki-only operation (skips all GitHub login/token setup)
COPILOT_ENABLED=true
# Credentials are saved by `npm run auth:loki` under DATA_DIR/loki/auth.
# Headless/container: npm run auth:loki -- --device-code
# Broker-bound organization policies require Windows native execution, not Linux Docker.
